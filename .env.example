# ====================================================================
# Wonderlust Environment Variables Template
# Copy this file to .env or .env.local and update with your real values.
# NEVER commit your actual .env file to version control.
# ====================================================================

# Database Configuration (MongoDB)
MONGODB_URI=mongodb://127.0.0.1:27017/wonderlust

# Cache Configuration (Redis)
# Leave blank or use local instance; app will gracefully fallback to in-memory/direct DB
REDIS_URL=redis://127.0.0.1:6379

# Cloudinary Image Hosting Configuration
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# MapTiler Maps Integration
NEXT_PUBLIC_MAPTILER_KEY=your_maptiler_api_key

# Authentication Secret (Generate a strong random string)
JWT_SECRET=your_super_secret_jwt_key_at_least_32_chars

# Administrator Credentials (Used to auto-provision initial admin account)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_this_secure_password
ADMIN_USERNAME=Administrator
